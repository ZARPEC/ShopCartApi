# Servidor Express
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Base de datos SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_NAME=ShopCartDB
DB_USER=usr_shopcart_app
DB_PASSWORD=TU_PASSWORD_AQUI
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_ENCRYPT=false
DB_TRUST_SERVER_CERTIFICATE=true

# Autenticación JWT 
JWT_ACCESS_SECRET=reemplazar_por_secreto_access_minimo_32_caracteres
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=reemplazar_por_secreto_refresh_minimo_32_caracteres
JWT_REFRESH_EXPIRES_DAYS=7
BCRYPT_SALT_ROUNDS=10